{
  "name": "word-cloud",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://<YOUR_USERNAME>.github.io/word.cloud",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "start": "npm run build && node server/index.js",
    "dev:start": "node server/index.js",
    "setup": "npm install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "react-wordcloud": "^1.2.7",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0",
    "concurrently": "^8.2.0"
  }
}
